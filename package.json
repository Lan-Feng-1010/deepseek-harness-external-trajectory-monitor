{
  "name": "dsh-external-trajectory-importer",
  "version": "0.3.2",
  "private": true,
  "description": "Read-only live Codex, Claude, and ImplantAgent JSONL trajectory projection and deterministic statistics for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "runtime-sources.json",
    "live-sources.json",
    "live-sources.example.json",
    "README.md",
    "SECURITY.md",
    "docs",
    "lib",
    "src",
    "tsdown.config.ts",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lan-Feng-1010/deepseek-harness-external-trajectory-monitor.git"
  },
  "keywords": [
    "deepseek-harness",
    "trajectory",
    "observability",
    "codex",
    "claude",
    "implantagent"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "validate": "node ./scripts/validate.mjs"
  }
}

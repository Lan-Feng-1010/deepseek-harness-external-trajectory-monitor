{
  "name": "dsh-external-trajectory-importer",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Read-only live Codex, Claude, and ImplantAgent JSONL trajectory projection and deterministic statistics for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "runtime-sources.json",
    "live-sources.json",
    "live-sources.example.json",
    "README.md",
    "SECURITY.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lan-Feng-1010/deepseek-harness-external-trajectory-monitor.git"
  },
  "keywords": [
    "deepseek-harness",
    "trajectory",
    "observability",
    "codex",
    "claude",
    "implantagent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "oxlint": "1.76.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsdown && tsx scripts/sanitize-build.ts",
    "lint": "oxlint src scripts tsdown.config.ts",
    "validate": "tsx ./scripts/validate.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run validate"
  }
}
